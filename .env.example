# העתיקו את הקובץ ל-.env.local ומלאו את הערכים. .env.local לא נכנס ל-git.

# מזהה הבסיס: מתחיל ב-app, ומופיע בכתובת של הבסיס (airtable.com/appXXXXXXXXXXXXXX/...)
VITE_AIRTABLE_BASE_ID=

# טוקן קריאה בלבד, לאתר. Scope: data.records:read. Access: הבסיס הזה בלבד.
# הוא גלוי בקוד האתר, ולכן קריאה בלבד ולבסיס של נתוני דמה בלבד (SPEC.md).
VITE_AIRTABLE_TOKEN=

# טוקן כתיבה, רק לסקריפט הטעינה (pnpm seed). לא מתחיל ב-VITE_, ולכן לא נכנס לאתר.
# Scopes: data.records:read, data.records:write, schema.bases:read, schema.bases:write. Access: הבסיס הזה בלבד.
# אחרי הטעינה אפשר למחוק אותו ב-Airtable.
AIRTABLE_WRITE_TOKEN=
